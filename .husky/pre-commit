#!/bin/sh
. "$(dirname "$0")/_/husky.sh"
. "$(dirname "$0")/common.sh"

[ -n "$CI" ] && exit 0

PATH="/usr/local/bin:$PATH"

# Windows Git Bash 下 `pnpm exec lint-staged` 可能无法解析 .bin shim，改为 node 直调
# Perform lint check on files in the staging area through .lintstagedrc configuration
node "$(dirname "$0")/../node_modules/lint-staged/bin/lint-staged.js"